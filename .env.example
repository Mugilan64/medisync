# MediSync Environment Configuration
# Copy this file to .env and update values for your environment

# Database
MYSQL_ROOT_PASSWORD=MediSync@Root2024
MYSQL_DATABASE=medisync_db
MYSQL_USER=medisync_user
MYSQL_PASSWORD=MediSync@Pass2024

# Backend
SECRET_KEY=change_this_to_a_very_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Frontend
VITE_API_URL=http://localhost:8000

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@medisync.health
